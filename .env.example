# Local build, signing and release settings for Downhole Studio.
# Copy to .env and fill in. .env is git-ignored: never commit it, and never put private keys in the repository.
# Licence-server secrets live separately in server/.env (see server/.env.example).

# --- Code signing (Windows, scripts/build.ps1 -Sign) -----------------------------------------------
# SHA-1 thumbprint of the QuakeLogic code-signing certificate in the Windows certificate store.
DHS_CERT_THUMBPRINT=
# Or a complete sign command for a cloud HSM / hardware token; "$f" is replaced with the file to sign.
DHS_SIGN_COMMAND=
DHS_TIMESTAMP_URL=http://timestamp.digicert.com

# --- GitHub release (scripts/publish-release.sh) ---------------------------------------------------
# owner/repository that hosts the releases the README download link points to.
GITHUB_REPOSITORY=omerozgul11/ql-downhole
# Fine-grained personal access token with "Contents: read and write" on that repository only.
GITHUB_TOKEN=
