# Copy to .env and fill in. Never commit .env or the secrets/ folder.
POSTGRES_PASSWORD=change-me-long-random
# 32+ random bytes, e.g. `openssl rand -hex 32`. Changing it later invalidates every issued licence key.
LICENSING_KEY_PEPPER=change-me-openssl-rand-hex-32
# Folder with license-signing-key.pem and update-signing-key.pem (private keys; keep outside the repository).
SIGNING_KEYS_DIR=./secrets
LICENSING_SIGNING_KEY_ID=dhs-lic-2026a
UPDATES_SIGNING_KEY_ID=dhs-upd-2026a
STRIPE_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=licensing@quakelogic.net
LICENSE_SERVER_PORT=8080
ADMIN_PORTAL_PORT=8081
# Container user; must be able to read the signing key files (run `id -u` for the keys' owner).
DHS_CONTAINER_USER=1654
# Admin portal on the office network over HTTPS (docker compose --profile lan up -d). Never forward this port from the internet.
ADMIN_LAN_ADDRESS=192.168.1.225
ADMIN_LAN_BIND=192.168.1.225
ADMIN_LAN_PORT=50030
ADMIN_EMAIL=
ADMIN_PASSWORD=
