@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}
<div class="card narrow">
    <h1>Something went wrong</h1>
    <p>The request could not be completed. Try again; if it keeps happening, check the server logs.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted">Request ID: <code>@Model.RequestId</code></p>
    }
</div>
