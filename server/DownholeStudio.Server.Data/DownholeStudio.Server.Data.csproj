    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DownholeStudio.Licensing\DownholeStudio.Licensing.csproj" />
  </ItemGroup>
