<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DownholeStudio.Visualization</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DownholeStudio.Domain\DownholeStudio.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fonts/*.ttf" />
    <None Include="Fonts/Inter-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
</Project>
