<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:DownholeStudio.App.ViewModels.Pages"
             xmlns:img="using:Avalonia.Media.Imaging"
             x:Class="DownholeStudio.App.Views.Pages.ReportPageView"
             x:DataType="p:ReportPageViewModel">
  <Grid ColumnDefinitions="520,16,*">
    <ScrollViewer>
      <StackPanel Spacing="14" Margin="0,0,8,0">
        <!-- Generate -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="PDF report" />
            <StackPanel><TextBlock Classes="label" Text="Report title" /><TextBox Text="{Binding ReportTitle, UpdateSourceTrigger=LostFocus}" PlaceholderText="Downhole Seismic Survey — project name" /></StackPanel>
            <Grid ColumnDefinitions="*,8,*,8,*">
              <StackPanel><TextBlock Classes="label" Text="Revision" /><TextBox Text="{Binding Revision, UpdateSourceTrigger=LostFocus}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Paper" /><ComboBox ItemsSource="{x:Static p:ReportPageViewModel.PaperOptions}" SelectedItem="{Binding Paper}" HorizontalAlignment="Stretch" /></StackPanel>
            </Grid>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Classes="primary" Command="{Binding GenerateCommand}" IsEnabled="{Binding !IsBusy}"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Report}" Classes="sm" Foreground="White" /><TextBlock Text="Generate PDF…" Foreground="White" /></StackPanel></Button>
              <Button Content="Preview" Command="{Binding PreviewCommand}" IsEnabled="{Binding !IsBusy}" />
              <Button Content="Open last report" Command="{Binding OpenReportCommand}" IsVisible="{Binding LastReportPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </WrapPanel>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <TextBlock Classes="muted wrap" Text="{Binding Status}" />
          </StackPanel>
        </Border>

        <Expander Header="Sections" HorizontalAlignment="Stretch">
          <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="p:SectionToggle"><CheckBox IsChecked="{Binding IsOn}" Content="{Binding Label}" /></DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <Expander Header="Client and site" HorizontalAlignment="Stretch" IsExpanded="True">
          <StackPanel Spacing="8">
            <StackPanel><TextBlock Classes="label" Text="Client" /><TextBox Text="{Binding ClientName, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel><TextBlock Classes="label" Text="Contact" /><TextBox Text="{Binding ClientContact, UpdateSourceTrigger=LostFocus}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Email" /><TextBox Text="{Binding ClientEmail, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            </Grid>
            <StackPanel><TextBlock Classes="label" Text="Client address" /><TextBox Text="{Binding ClientAddress, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Site" /><TextBox Text="{Binding SiteName, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Site address" /><TextBox Text="{Binding SiteAddress, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel><TextBlock Classes="label" Text="Latitude" /><TextBox Text="{Binding Latitude, UpdateSourceTrigger=LostFocus}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Longitude" /><TextBox Text="{Binding Longitude, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            </Grid>
          </StackPanel>
        </Expander>

        <Expander Header="Instruments" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <StackPanel><TextBlock Classes="label" Text="Seismograph" /><TextBox Text="{Binding Seismograph, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel><TextBlock Classes="label" Text="Borehole sensor" /><TextBox Text="{Binding Sensor, UpdateSourceTrigger=LostFocus}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Serial number" /><TextBox Text="{Binding SensorSerial, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            </Grid>
            <StackPanel><TextBlock Classes="label" Text="P source" /><TextBox Text="{Binding PSource, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="S source" /><TextBox Text="{Binding SSource, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Trigger" /><TextBox Text="{Binding Trigger, UpdateSourceTrigger=LostFocus}" /></StackPanel>
          </StackPanel>
        </Expander>

        <Expander Header="Company branding" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <Border Classes="sunken" Width="160" Height="64" Padding="6">
                <Panel>
                  <Image Source="{Binding Logo}" Stretch="Uniform" />
                  <TextBlock Text="No logo" Classes="faint" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasLogo}" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                <Button Content="Choose logo…" Command="{Binding ChooseLogoCommand}" />
                <Button Classes="link" Content="Remove logo" Command="{Binding ClearLogoCommand}" IsVisible="{Binding HasLogo}" />
              </StackPanel>
            </Grid>
            <StackPanel><TextBlock Classes="label" Text="Company name" /><TextBox Text="{Binding Company, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Address" /><TextBox Text="{Binding CompanyAddress, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel><TextBlock Classes="label" Text="Phone" /><TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=LostFocus}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Email" /><TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            </Grid>
            <StackPanel><TextBlock Classes="label" Text="Website" /><TextBox Text="{Binding CompanyWebsite, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Report footer" /><TextBox Text="{Binding Footer, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel><TextBlock Classes="label" Text="Engineer / geophysicist" /><TextBox Text="{Binding Engineer, UpdateSourceTrigger=LostFocus}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Title" /><TextBox Text="{Binding EngineerTitle, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            </Grid>
            <StackPanel><TextBlock Classes="label" Text="License / registration" /><TextBox Text="{Binding Registration, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" PlaceholderText="Saved templates" Width="200" />
              <Button Content="Apply template" Command="{Binding ApplyTemplateCommand}" />
              <TextBox Text="{Binding NewTemplateName}" PlaceholderText="Template name" Width="150" />
              <Button Content="Save as template" Command="{Binding SaveTemplateCommand}" />
            </WrapPanel>
          </StackPanel>
        </Expander>

        <Expander Header="Sign-off, notes and conclusions" HorizontalAlignment="Stretch">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel><TextBlock Classes="label" Text="Prepared by" /><TextBox Text="{Binding PreparedBy, UpdateSourceTrigger=LostFocus}" /></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Classes="label" Text="Checked by" /><TextBox Text="{Binding CheckedBy, UpdateSourceTrigger=LostFocus}" /></StackPanel>
            </Grid>
            <StackPanel><TextBlock Classes="label" Text="Processing notes" /><TextBox Text="{Binding ProcessingNotes, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" /></StackPanel>
            <StackPanel><TextBlock Classes="label" Text="Conclusions" /><TextBox Text="{Binding Conclusions, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" /></StackPanel>
          </StackPanel>
        </Expander>

        <!-- Exports -->
        <Border Classes="card">
          <StackPanel Spacing="10">
            <TextBlock Classes="h2" Text="Exports" />
            <TextBlock Classes="label" Text="Tables" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
              <Button Command="{Binding ExportXlsxCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Table}" Classes="sm" /><TextBlock Text="All tables (Excel)" /></StackPanel></Button>
              <Button Content="Pick table (CSV)" Command="{Binding ExportCsvCommand}" CommandParameter="picks" />
              <Button Content="Layers (CSV)" Command="{Binding ExportCsvCommand}" CommandParameter="layers" />
              <Button Content="Engineering (CSV)" Command="{Binding ExportCsvCommand}" CommandParameter="engineering" />
              <Button Content="Intervals (CSV)" Command="{Binding ExportCsvCommand}" CommandParameter="intervals" />
              <Button Content="QC (CSV)" Command="{Binding ExportCsvCommand}" CommandParameter="qc" />
              <Button Content="History (CSV)" Command="{Binding ExportCsvCommand}" CommandParameter="history" />
            </WrapPanel>
            <TextBlock Classes="label" Text="Figures" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="*,8,*">
              <ComboBox ItemsSource="{x:Static p:ReportPageViewModel.FigureOptions}" SelectedItem="{Binding Figure}" HorizontalAlignment="Stretch" />
              <ComboBox Grid.Column="2" ItemsSource="{x:Static p:ReportPageViewModel.FormatOptions}" SelectedItem="{Binding FigureFormat}" HorizontalAlignment="Stretch" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding FigureWidth}" Minimum="200" Maximum="12000" Increment="100" FormatString="0" Width="120" />
              <TextBlock Text="×" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding FigureHeight}" Minimum="150" Maximum="12000" Increment="100" FormatString="0" Width="120" />
              <TextBlock Text="px" VerticalAlignment="Center" Classes="muted" />
              <CheckBox IsChecked="{Binding Transparent}" Content="Transparent background" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Command="{Binding ExportFigureCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Image}" Classes="sm" /><TextBlock Text="Export figure…" /></StackPanel></Button>
              <Button Command="{Binding CopyFigureCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Copy}" Classes="sm" /><TextBlock Text="Copy to clipboard" /></StackPanel></Button>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Preview -->
    <Border Grid.Column="2" Classes="panel" Background="{DynamicResource SurfaceSunken}">
      <Panel>
        <StackPanel IsVisible="{Binding !HasPreview}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <PathIcon Data="{StaticResource Icon.Report}" Width="40" Height="40" Foreground="{DynamicResource TextFaint}" />
          <TextBlock Classes="muted" Text="Click Preview to see the report pages here." />
        </StackPanel>
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding PreviewPages}" Margin="20">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="img:Bitmap">
                <Border Margin="0,0,0,16" HorizontalAlignment="Center" BoxShadow="0 2 12 0 #33000000">
                  <Image Source="{Binding}" Stretch="Uniform" MaxWidth="760" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Panel>
    </Border>
  </Grid>
</UserControl>
