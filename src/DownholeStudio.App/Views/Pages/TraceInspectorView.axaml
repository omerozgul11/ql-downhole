<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:DownholeStudio.App.ViewModels.Pages"
             x:Class="DownholeStudio.App.Views.Pages.TraceInspectorView"
             x:DataType="p:TraceInspectorViewModel">
  <StackPanel Spacing="12">
    <TextBlock Classes="h2" Text="{Binding Header}" />
    <ItemsControl ItemsSource="{Binding RowItems}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="p:ReadoutRow">
          <Grid ColumnDefinitions="110,*" Margin="0,2">
            <TextBlock Text="{Binding Key}" Classes="muted" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Classes="sunken">
      <StackPanel Spacing="2"><TextBlock Classes="caps" Text="PROCESSING" /><TextBlock Text="{Binding Pipeline}" TextWrapping="Wrap" /></StackPanel>
    </Border>
    <StackPanel Spacing="8">
      <TextBlock Classes="caps" Text="THIS TRACE" />
      <StackPanel><TextBlock Classes="label" Text="{Binding Gain, StringFormat='Display gain {0:0.0#}×'}" /><Slider Minimum="0.1" Maximum="10" Value="{Binding Gain}" /></StackPanel>
      <CheckBox IsChecked="{Binding ReversePolarity}" Content="Reverse polarity" />
      <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Static shift (ms)" Classes="muted" VerticalAlignment="Center" /><NumericUpDown Value="{Binding TimeShiftMs}" Increment="0.1" FormatString="0.###" Width="120" /></StackPanel>
      <CheckBox IsChecked="{Binding Excluded}" Content="Exclude this trace" />
    </StackPanel>
    <Border Classes="sunken" IsVisible="{Binding PickText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <StackPanel Spacing="4">
        <TextBlock Classes="caps" Text="PICK" />
        <TextBlock Text="{Binding PickText}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ConfidenceText}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding SnrText}" Classes="muted" />
        <ItemsControl ItemsSource="{Binding Factors}" IsVisible="{Binding HasFactors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="p:FactorRow">
              <StackPanel Margin="0,3">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium" /><TextBlock Grid.Column="1" Text="{Binding Score, StringFormat='{}{0:0.00}'}" FontSize="12" /></Grid>
                <ProgressBar Value="{Binding Score}" Maximum="1" Height="4" MinHeight="4" />
                <TextBlock Text="{Binding Explanation}" Classes="faint wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Flags}" IsVisible="{Binding HasFlags}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="p:FlagRow">
          <Border Margin="0,3" Classes.badbox="{Binding IsError}" Classes.warnbox="{Binding IsWarning}" Classes.guide="{Binding IsInfo}">
            <StackPanel>
              <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" />
              <TextBlock Text="{Binding Explanation}" Classes="faint wrap" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
