<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:DownholeStudio.App.ViewModels.Pages"
             xmlns:c="using:DownholeStudio.App.Controls"
             x:Class="DownholeStudio.App.Views.Pages.VelocityPageView"
             x:DataType="p:VelocityPageViewModel">
  <Grid RowDefinitions="Auto,Auto,*,10,250">
    <Border Classes="card" Padding="12,8">
      <WrapPanel ItemSpacing="12" LineSpacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Method" Classes="muted" VerticalAlignment="Center" /><ComboBox ItemsSource="{x:Static p:VelocityPageViewModel.MethodOptions}" SelectedItem="{Binding Method}" Width="330" /></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="Regression" Classes="muted" VerticalAlignment="Center" /><ComboBox ItemsSource="{x:Static p:VelocityPageViewModel.RegressionOptions}" SelectedItem="{Binding Regression}" Width="200" /></StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsExpert}"><TextBlock Text="Huber k" Classes="muted" VerticalAlignment="Center" /><NumericUpDown Value="{Binding HuberK}" Increment="0.1" Minimum="0.5" Maximum="5" FormatString="0.###" Width="100" /></StackPanel>
        <Border Width="1" Height="24" Background="{DynamicResource Border}" />
        <CheckBox IsChecked="{Binding ShowP}" Content="P" />
        <CheckBox IsChecked="{Binding ShowS}" Content="S" />
        <CheckBox IsChecked="{Binding VerticalTime}" Content="Corrected (vertical) time" />
      </WrapPanel>
    </Border>
    <TextBlock Grid.Row="1" Classes="faint wrap" Margin="4,8" Text="{Binding MethodNote}" />

    <Grid Grid.Row="2" ColumnDefinitions="2*,10,*,10,1.4*">
      <Border Classes="panel" Padding="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Bottom" Classes="faint" Margin="10,2,10,6" Text="Drag a dashed boundary to move it · Ctrl+click adds a boundary · Shift+click a point to exclude/include it · wheel to zoom" />
          <c:PlotView x:Name="TravelTimePlot" Model="{Binding TravelTime}" />
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Classes="panel" Padding="4"><c:PlotView Model="{Binding Residuals}" /></Border>
      <Border Grid.Column="4" Classes="panel" Padding="4">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,6">
            <ComboBox ItemsSource="{x:Static p:VelocityPageViewModel.ProfileOptions}" SelectedItem="{Binding ProfileKind}" Width="190" />
            <CheckBox IsChecked="{Binding Labels}" Content="Labels" />
          </StackPanel>
          <c:PlotView x:Name="ProfilePlot" Model="{Binding Profile}" />
        </DockPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="4" ColumnDefinitions="*,10,360">
      <Border Classes="panel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8">
            <StackPanel>
              <TextBlock Classes="h3" Text="Layers" />
              <TextBlock Classes="faint" Text="{Binding FitSummary}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding NewBoundary}" PlaceholderText="{Binding LengthUnit, StringFormat='Depth ({0})'}" Width="110" />
              <Button Content="Add boundary" Command="{Binding AddBoundaryCommand}" />
              <Button Command="{Binding SuggestCommand}"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Data="{StaticResource Icon.Auto}" Classes="sm" /><TextBlock Text="Suggest boundaries" /></StackPanel></Button>
            </StackPanel>
          </Grid>
          <DataGrid ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayerRow}" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Top" Binding="{Binding Top}" />
              <DataGridTextColumn Header="Bottom" Binding="{Binding Bottom}" />
              <DataGridTextColumn Header="Thickness" Binding="{Binding Thickness}" />
              <DataGridTextColumn Header="Vp" Binding="{Binding Vp}" />
              <DataGridTextColumn Header="Vs" Binding="{Binding Vs}" />
              <DataGridTextColumn Header="P fit" Binding="{Binding PFit}" />
              <DataGridTextColumn Header="S fit" Binding="{Binding SFit}" />
              <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Classes="panel">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,8">
            <TextBlock Classes="h3" Text="Suggested boundaries" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasSuggestions}">
              <Button Content="Apply all" Command="{Binding ApplyAllSuggestionsCommand}" />
              <Button Classes="subtle" Content="Dismiss" Command="{Binding DismissSuggestionsCommand}" />
            </StackPanel>
          </Grid>
          <Panel>
            <TextBlock Classes="muted wrap" Margin="12,0" Text="Suggest boundaries looks for slope changes in the travel times. Suggestions are never applied without your confirmation." IsVisible="{Binding !HasSuggestions}" />
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Suggestions}" Margin="8,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="p:SuggestionRow">
                    <Grid ColumnDefinitions="*,Auto" Margin="4,4">
                      <StackPanel>
                        <TextBlock Text="{Binding DepthText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Reason}" Classes="faint wrap" />
                      </StackPanel>
                      <Button Grid.Column="1" Content="Apply" VerticalAlignment="Center" Command="{Binding $parent[UserControl].((p:VelocityPageViewModel)DataContext).ApplySuggestionCommand}" CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Panel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
