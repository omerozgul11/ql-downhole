<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DownholeStudio.App.ViewModels"
             xmlns:lic="using:DownholeStudio.Licensing"
             x:Class="DownholeStudio.App.Views.LicenseView"
             x:DataType="vm:LicenseViewModel">
  <Border Background="{DynamicResource Overlay}">
    <Border Classes="card" Width="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24">
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Image Source="/Assets/quakelogic-mark.png" Width="48" Height="48" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Classes="h1" Text="{Binding Title}" />
            <TextBlock Classes="muted wrap" Text="{Binding Message}" MaxWidth="500" />
          </StackPanel>
        </StackPanel>

        <!-- Offline activation: computer code out, activation key in. Works without an internet connection. -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowOfflineActivation}">
          <TextBlock Classes="label" Text="1. Send this computer's code to QuakeLogic" />
          <Border Classes="guide" Padding="12,8">
            <StackPanel Spacing="8">
              <SelectableTextBlock Text="{Binding ComputerCode}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Copy Code" Command="{Binding CopyComputerCodeCommand}" />
                <Button Content="E-mail to QuakeLogic" Command="{Binding EmailComputerCodeCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Classes="faint wrap" Text="The code identifies this computer only; it contains no personal or project data. QuakeLogic replies with an activation key for this computer." />
          <TextBlock Classes="label" Text="2. Enter the activation key you received" />
          <TextBox Text="{Binding ActivationKey}" AcceptsReturn="True" TextWrapping="Wrap" Height="76" PlaceholderText="Paste the activation key from the e-mail (it starts with dhs1.)" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="primary" Content="Activate" Command="{Binding ActivateOfflineCommand}" />
            <Button Content="Open Activation File…" Command="{Binding OpenActivationFileCommand}" />
          </StackPanel>
        </StackPanel>

        <!-- Online activation with a licence key (only when a licensing server is configured) -->
        <StackPanel Spacing="10" IsVisible="{Binding ShowActivate}">
          <StackPanel>
            <TextBlock Classes="label" Text="Email" />
            <TextBox Text="{Binding Email}" PlaceholderText="name@company.com" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="label" Text="License Key" />
            <TextBox Text="{Binding LicenseKey}" PlaceholderText="DHST-XXXX-XXXX-XXXX-XXXX" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
          </StackPanel>
          <CheckBox IsChecked="{Binding ShareMachineName}" Content="Send this computer's name so I can recognise it in my device list" />
          <Button Classes="primary" Content="Activate Online" Command="{Binding ActivateCommand}" HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
        <Button Classes="link" Content="Activate online with a license key instead" Command="{Binding ShowActivateFormCommand}" IsVisible="{Binding ShowActivateLink}" />

        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        <Border Classes="badbox" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Bad}" />
            <ItemsControl ItemsSource="{Binding Devices}" IsVisible="{Binding HasDevices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="lic:ActivatedDeviceInfo">
                  <TextBlock FontSize="12"><Run Text="• " /><Run Text="{Binding DeviceLabel}" FontWeight="Medium" /><Run Text=" — activated " /><Run Text="{Binding ActivatedAt, StringFormat='{}{0:d}'}" /></TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock FontSize="12" Classes="muted wrap" IsVisible="{Binding HasDevices}"
                       Text="Deactivate one of these computers from Settings → License on that computer, or contact QuakeLogic support to move the license." />
          </StackPanel>
        </Border>

        <!-- Licence details -->
        <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="{Binding IsLicensed}">
          <TextBlock Grid.Row="0" Classes="muted" Text="Product" /><TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Product}" FontWeight="Medium" />
          <TextBlock Grid.Row="1" Classes="muted" Text="Status" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Chip}" />
          <TextBlock Grid.Row="2" Classes="muted" Text="Licensed to" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LicensedTo}" />
          <TextBlock Grid.Row="3" Classes="muted" Text="Computer" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Device}" />
          <TextBlock Grid.Row="4" Classes="muted" Text="Computer code" /><SelectableTextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ComputerCode}" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" />
          <TextBlock Grid.Row="5" Classes="muted" Text="Expires" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Expires}" />
          <TextBlock Grid.Row="6" Classes="muted" Text="Maintenance until" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Maintenance}" />
        </Grid>
        <WrapPanel ItemSpacing="8" LineSpacing="8" IsVisible="{Binding IsLicensed}">
          <Button Content="Verify Online" Command="{Binding RefreshOnlineCommand}" IsVisible="{Binding CanVerifyOnline}" />
          <Button Content="Copy License Information" Command="{Binding CopyInfoCommand}" />
          <Button Content="{Binding DeactivateLabel}" Command="{Binding DeactivateCommand}" Classes="danger" />
        </WrapPanel>

        <Border Classes="divider" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="faint wrap" MaxWidth="420"
                     Text="Activation works without an internet connection. Your survey data never leaves this computer." />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <Button Classes="link" Content="Buy a license" Command="{Binding BuyCommand}" IsVisible="{Binding !IsLicensed}" />
            <Button Classes="link" Content="Privacy" Command="{Binding PrivacyCommand}" />
            <Button Content="Close" Command="{Binding CloseCommand}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
