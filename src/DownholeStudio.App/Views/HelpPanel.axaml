<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DownholeStudio.App.ViewModels"
             x:Class="DownholeStudio.App.Views.HelpPanel"
             x:DataType="vm:MainViewModel">
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0" BoxShadow="-6 0 24 0 #22000000">
    <DockPanel DataContext="{Binding Help}" x:DataType="vm:HelpViewModel">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,12">
        <TextBlock Classes="h2" Text="Help &amp; user guide" />
        <Button Grid.Column="1" Classes="subtle" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ToggleHelpCommand}" ToolTip.Tip="Close help">
          <PathIcon Data="{StaticResource Icon.Close}" Classes="sm" />
        </Button>
      </Grid>
      <TextBox DockPanel.Dock="Top" Margin="16,0,16,8" PlaceholderText="Search the guide" Text="{Binding Search}" />
      <ScrollViewer DockPanel.Dock="Top" MaxHeight="150" Margin="8,0">
        <ItemsControl ItemsSource="{Binding Topics}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HelpTopic">
              <Button Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8,4" Content="{Binding Title}"
                      Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Help.ShowCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <Border DockPanel.Dock="Top" Classes="divider" Margin="16,6" />
      <ScrollViewer>
        <StackPanel Margin="16,4,16,16" Spacing="10">
          <TextBlock Classes="h2 wrap" Text="{Binding Current.Title, FallbackValue=''}" />
          <SelectableTextBlock Text="{Binding Current.Body, FallbackValue=''}" TextWrapping="Wrap" LineHeight="20" />
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
